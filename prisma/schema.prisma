generator client {
  provider = "prisma-client-js"
}

datasource db {
  provider = "mysql"
  url      = env("DATABASE_URL")
}

model Empresa {
  id          Int              @id @default(autoincrement())
  nome        String           @db.VarChar(200)
  cnpj        String?          @unique @db.VarChar(18)
  ativa       Boolean          @default(true)
  criadoEm    DateTime         @default(now()) @map("criado_em")
  contas      Conta[]
  lancamentos Lancamento[]
  lancamentosPadrao LancamentoPadrao[]
  usuarios    UsuarioEmpresa[]
  notasFiscais NotaFiscal[]
  apuracoesFiscais ApuracaoFiscal[]

  @@map("empresas")
}

model Usuario {
  id           Int              @id @default(autoincrement())
  nome         String           @db.VarChar(150)
  email        String           @unique @db.VarChar(191)
  senha        String           @db.VarChar(255)
  ativo        Boolean          @default(true)
  criadoEm     DateTime         @default(now()) @map("criado_em")
  atualizadoEm DateTime         @updatedAt @map("atualizado_em")
  empresas     UsuarioEmpresa[]

  @@map("usuarios")
}

model UsuarioEmpresa {
  id         Int      @id @default(autoincrement())
  usuarioId  Int      @map("usuario_id")
  empresaId  Int      @map("empresa_id")
  papel      String   @default("ADMIN") @db.VarChar(20)
  permissoes Json?
  criadoEm   DateTime @default(now()) @map("criado_em")

  usuario    Usuario  @relation(fields: [usuarioId], references: [id], onDelete: Cascade)
  empresa    Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@unique([usuarioId, empresaId])
  @@index([empresaId])
  @@index([usuarioId])
  @@map("usuario_empresas")
}

model Conta {
  id           Int      @id @default(autoincrement())
  codigo       String   @db.VarChar(20)
  reduzido     Int?
  nome         String   @db.VarChar(200)
  tipo         String   @db.VarChar(10)
  natureza     String   @db.VarChar(10)
  nivel        Int
  grupo        String   @db.VarChar(30)
  ativa        Boolean  @default(true)
  contaPaiId   Int?     @map("conta_pai_id")
  empresaId    Int      @map("empresa_id")
  criadoEm     DateTime @default(now()) @map("criado_em")
  atualizadoEm DateTime @updatedAt @map("atualizado_em")

  contaPai     Conta?   @relation("ContaHierarquia", fields: [contaPaiId], references: [id])
  contasFilhas Conta[]  @relation("ContaHierarquia")
  empresa      Empresa  @relation(fields: [empresaId], references: [id])

  lancamentosDebito  Lancamento[] @relation("LancamentosDebito")
  lancamentosCredito Lancamento[] @relation("LancamentosCredito")
  padroesDebito      LancamentoPadrao[] @relation("PadraoDebito")
  padroesCredito     LancamentoPadrao[] @relation("PadraoCredito")

  @@unique([codigo, empresaId])
  @@unique([empresaId, reduzido])
  @@index([empresaId])
  @@index([contaPaiId])
  @@map("contas")
}

model Lancamento {
  id              Int      @id @default(autoincrement())
  data            DateTime @db.Date
  documento       String?  @db.VarChar(100)
  valor           Decimal  @db.Decimal(15, 2)
  historico       String   @db.Text
  contaDebitoId   Int      @map("conta_debito_id")
  contaCreditoId  Int      @map("conta_credito_id")
  empresaId       Int      @map("empresa_id")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  contaDebito     Conta    @relation("LancamentosDebito", fields: [contaDebitoId], references: [id])
  contaCredito    Conta    @relation("LancamentosCredito", fields: [contaCreditoId], references: [id])
  empresa         Empresa  @relation(fields: [empresaId], references: [id])

  @@index([empresaId])
  @@index([contaDebitoId])
  @@index([contaCreditoId])
  @@map("lancamentos")
}

model LancamentoPadrao {
  id              Int      @id @default(autoincrement())
  descricao       String   @db.VarChar(150)
  historico       String   @db.Text
  contaDebitoId   Int      @map("conta_debito_id")
  contaCreditoId  Int      @map("conta_credito_id")
  empresaId       Int      @map("empresa_id")
  criadoEm        DateTime @default(now()) @map("criado_em")
  atualizadoEm    DateTime @updatedAt @map("atualizado_em")

  contaDebito     Conta    @relation("PadraoDebito", fields: [contaDebitoId], references: [id])
  contaCredito    Conta    @relation("PadraoCredito", fields: [contaCreditoId], references: [id])
  empresa         Empresa  @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  @@index([empresaId])
  @@index([contaDebitoId])
  @@index([contaCreditoId])
  @@map("lancamentos_padrao")
}

model NotaFiscal {
  id                  Int               @id @default(autoincrement())
  chaveAcesso         String            @unique @map("chave_acesso") @db.VarChar(44)
  numero              String            @db.VarChar(20)
  serie               String            @default("1") @db.VarChar(10)
  modelo              String            @default("55") @db.VarChar(5) // 55 = NF-e, 65 = NFC-e
  tipoOperacao        String            @default("SAIDA") @map("tipo_operacao") @db.VarChar(10) // SAIDA ou ENTRADA
  dataEmissao         DateTime          @map("data_emissao") @db.Date
  naturezaOp          String?           @map("natureza_op") @db.VarChar(150)
  
  // Emitente
  emitenteCnpj        String            @map("emitente_cnpj") @db.VarChar(20)
  emitenteNome        String            @map("emitente_nome") @db.VarChar(200)
  emitenteUf          String?           @map("emitente_uf") @db.VarChar(2)

  // Destinatário
  destinatarioCpfCnpj String?           @map("destinatario_cpf_cnpj") @db.VarChar(20)
  destinatarioNome    String?           @map("destinatario_nome") @db.VarChar(200)
  destinatarioUf      String?           @map("destinatario_uf") @db.VarChar(2)

  // Totais
  valorProdutos       Decimal           @default(0) @map("valor_produtos") @db.Decimal(15, 2)
  valorFrete          Decimal           @default(0) @map("valor_frete") @db.Decimal(15, 2)
  valorDesconto       Decimal           @default(0) @map("valor_desconto") @db.Decimal(15, 2)
  valorTotal          Decimal           @map("valor_total") @db.Decimal(15, 2)

  // Tributos destacados
  valorIcms           Decimal           @default(0) @map("valor_icms") @db.Decimal(15, 2)
  valorPis            Decimal           @default(0) @map("valor_pis") @db.Decimal(15, 2)
  valorCofins         Decimal           @default(0) @map("valor_cofins") @db.Decimal(15, 2)

  // Integração Contábil
  integradaContabil   Boolean           @default(false) @map("integrada_contabil")
  lancamentoId        Int?              @map("lancamento_id")

  empresaId           Int               @map("empresa_id")
  empresa             Empresa           @relation(fields: [empresaId], references: [id], onDelete: Cascade)
  itens               ItemNotaFiscal[]

  criadoEm            DateTime          @default(now()) @map("criado_em")
  atualizadoEm        DateTime          @updatedAt @map("atualizado_em")

  @@index([empresaId, dataEmissao])
  @@index([empresaId, tipoOperacao])
  @@map("notas_fiscais")
}

model ItemNotaFiscal {
  id                    Int          @id @default(autoincrement())
  notaFiscalId          Int          @map("nota_fiscal_id")
  numeroItem            Int          @map("numero_item")
  codigoProduto         String       @map("codigo_produto") @db.VarChar(60)
  descricao             String       @db.VarChar(255)
  ncm                   String       @db.VarChar(10)
  cfop                  String       @db.VarChar(10)
  unidade               String       @default("UN") @db.VarChar(10)
  quantidade            Decimal      @db.Decimal(15, 4)
  valorUnitario         Decimal      @map("valor_unitario") @db.Decimal(15, 4)
  valorTotal            Decimal      @map("valor_total") @db.Decimal(15, 2)

  // Tributação
  cstCsosn              String?      @map("cst_csosn") @db.VarChar(10)
  monofasico            Boolean      @default(false)
  motivoMonofasico      String?      @map("motivo_monofasico") @db.VarChar(100)
  substituicaoTributaria Boolean     @default(false) @map("substituicao_tributaria")

  notaFiscal            NotaFiscal   @relation(fields: [notaFiscalId], references: [id], onDelete: Cascade)

  @@index([notaFiscalId])
  @@index([ncm])
  @@map("itens_nota_fiscal")
}

model ApuracaoFiscal {
  id                    Int       @id @default(autoincrement())
  empresaId             Int       @map("empresa_id")
  competencia           String    @db.VarChar(7) // Formato "YYYY-MM"
  regime                String    @default("SIMPLES_NACIONAL") @db.VarChar(30)
  
  // Receita
  faturamentoTotal      Decimal   @default(0) @map("faturamento_total") @db.Decimal(15, 2)
  faturamentoTributado  Decimal   @default(0) @map("faturamento_tributado") @db.Decimal(15, 2)
  faturamentoMonofasico Decimal   @default(0) @map("faturamento_monofasico") @db.Decimal(15, 2)
  faturamentoSt         Decimal   @default(0) @map("faturamento_st") @db.Decimal(15, 2)

  // Simples Nacional
  rbt12                 Decimal   @default(0) @db.Decimal(15, 2)
  anexo                 String    @default("ANEXO_I") @db.VarChar(20)
  aliquotaNominal       Decimal   @default(0) @map("aliquota_nominal") @db.Decimal(6, 4)
  parcelaDeduzir        Decimal   @default(0) @map("parcela_deduzir") @db.Decimal(15, 2)
  aliquotaEfetiva       Decimal   @default(0) @map("aliquota_efetiva") @db.Decimal(6, 4)

  // Valores Finais
  valorDasSemOtimizacao Decimal   @default(0) @map("valor_das_sem_otimizacao") @db.Decimal(15, 2)
  valorDasFinal         Decimal   @default(0) @map("valor_das_final") @db.Decimal(15, 2)
  economiaGerada        Decimal   @default(0) @map("economia_gerada") @db.Decimal(15, 2)

  // Integração Contábil da Apuração
  integradoContabil     Boolean   @default(false) @map("integrado_contabil")
  lancamentoId          Int?      @map("lancamento_id")

  empresa               Empresa   @relation(fields: [empresaId], references: [id], onDelete: Cascade)

  criadoEm              DateTime  @default(now()) @map("criado_em")
  atualizadoEm          DateTime  @updatedAt @map("atualizado_em")

  @@unique([empresaId, competencia])
  @@map("apuracoes_fiscais")
}



