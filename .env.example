# OPÇÃO 1: Banco Local (MySQL localhost)
# Formato: mysql://USUARIO:SENHA@HOST:PORTA/BANCO
DATABASE_URL="mysql://root:SUA_SENHA_AQUI@localhost:3306/contabilidade_db"

# OPÇÃO 2: Banco na Nuvem (ex: Aiven MySQL com SSL)
# DATABASE_URL="mysql://avnadmin:SUA_SENHA@mysql-host.aivencloud.com:19785/defaultdb?ssl-mode=REQUIRED"

# Segurança JWT
JWT_SECRET="c4a8f9027e1f49618c0e66d5b94f10738e4a90cd671c667e2a93ffb5f0962b1e"

# Inteligência Artificial / Comando de Voz (Google Gemini - Opcional)
